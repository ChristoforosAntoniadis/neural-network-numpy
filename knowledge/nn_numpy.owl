    <rdf:type rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#LayerType"/>
    <rdfs:label>Dense</rdfs:label>
    <rdfs:comment>Fully connected layer Z = X·W (+ b) with its backward pass.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Details">
