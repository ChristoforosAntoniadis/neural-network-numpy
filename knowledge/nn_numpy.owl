  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#EarlyStopping">
    <rdf:type rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#EarlyStoppingPolicy"/>
    <rdfs:label>early stopping</rdfs:label>
    <rdfs:comment>Stop after `patience` epochs without a validation-loss improvement of more than `minDelta`, never before `minEpochsBeforeEarlyStop` epochs, and restore the best checkpoint.</rdfs:comment>
    <nnfs:maxEpochs rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">100</nnfs:maxEpochs>
    <nnfs:minDelta rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0001</nnfs:minDelta>
    <nnfs:minEpochsBeforeEarlyStop rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</nnfs:minEpochsBeforeEarlyStop>
    <nnfs:patience rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</nnfs:patience>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#EnergyDataset">
