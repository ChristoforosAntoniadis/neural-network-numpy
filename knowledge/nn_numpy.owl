    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>runs</rdfs:label>
    <rdfs:comment>Inverse of runBy.</rdfs:comment>
    <owl:inverseOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#runBy"/>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#MakeTarget"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Module"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#seedOfSweep">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>seedOfSweep</rdfs:label>
    <rdfs:comment>Inverse of hasSeed.</rdfs:comment>
    <owl:inverseOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#hasSeed"/>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Seed"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Sweep"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#taskOfSweep">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>taskOfSweep</rdfs:label>
    <rdfs:comment>Inverse of onTask.</rdfs:comment>
    <owl:inverseOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#onTask"/>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Task"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Sweep"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#testedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>testedBy</rdfs:label>
    <rdfs:comment>The test module imports, and so exercises, the module.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Module"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#TestModule"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#upstreamOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>upstreamOf</rdfs:label>
    <rdfs:comment>Transitive closure of feeds: everything that, directly or through other nodes, contributes to a node.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#usedByArchitecture">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>usedByArchitecture</rdfs:label>
    <rdfs:comment>Inverse of usesTechnique.</rdfs:comment>
    <owl:inverseOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#usesTechnique"/>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Technique"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#usesHiddenActivation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>usesHiddenActivation</rdfs:label>
    <rdfs:comment>The activation of the hidden layers. An architecture has one.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Activation"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#usesLoss">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
    <rdfs:label>usesLoss</rdfs:label>
    <rdfs:comment>The training loss of the task. One loss per task, and one task per loss.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Task"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Loss"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#usesOutputActivation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>usesOutputActivation</rdfs:label>
    <rdfs:comment>The activation of the output layer for this task. A task has one.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Task"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Activation"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#usesTechnique">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>usesTechnique</rdfs:label>
    <rdfs:comment>The architecture uses the technique.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Technique"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#variantOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>variantOf</rdfs:label>
    <rdfs:comment>The architecture derives from the other one by one or more changes. Transitive: A2-bn-dropout is a variant of A2-bn, and so of A2.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#writes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
    <rdfs:label>writes</rdfs:label>
    <rdfs:comment>The module produces the artifact. Each artifact is written by one module.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#feeds"/>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Module"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Artifact"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#writtenBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>writtenBy</rdfs:label>
    <rdfs:comment>Inverse of writes.</rdfs:comment>
    <owl:inverseOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#writes"/>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Artifact"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Module"/>
  </owl:ObjectProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#batchSizeValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>batchSizeValue</rdfs:label>
    <rdfs:comment>The value.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#BatchSize"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#dropoutRate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>dropoutRate</rdfs:label>
    <rdfs:comment>Dropout rate after each hidden layer, if any.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#featureCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>featureCount</rdfs:label>
    <rdfs:comment>Number of input features.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Dataset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#filePattern">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>filePattern</rdfs:label>
    <rdfs:comment>Path pattern of a stamped or per-library output.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Artifact"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#hiddenLayerCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>hiddenLayerCount</rdfs:label>
    <rdfs:comment>Number of hidden layers.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#isStamped">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>isStamped</rdfs:label>
    <rdfs:comment>Whether each run writes a new file with a timestamp, so nothing is overwritten.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Artifact"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#learningRateValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>learningRateValue</rdfs:label>
    <rdfs:comment>The value.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#LearningRate"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#maxEpochs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>maxEpochs</rdfs:label>
    <rdfs:comment>Maximum number of epochs.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#EarlyStoppingPolicy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#maxGradNorm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>maxGradNorm</rdfs:label>
    <rdfs:comment>The gradient-norm cap, if the architecture clips gradients.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#minDelta">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>minDelta</rdfs:label>
    <rdfs:comment>Smallest validation-loss decrease that counts as an improvement.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#EarlyStoppingPolicy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#minEpochsBeforeEarlyStop">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>minEpochsBeforeEarlyStop</rdfs:label>
    <rdfs:comment>Epochs that must finish before early stopping can trigger.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#EarlyStoppingPolicy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#path">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>path</rdfs:label>
    <rdfs:comment>Path relative to the repository root.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#patience">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>patience</rdfs:label>
    <rdfs:comment>Epochs without a meaningful validation improvement before stopping.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#EarlyStoppingPolicy"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#runCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>runCount</rdfs:label>
    <rdfs:comment>Number of training runs in the grid over both tasks.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Sweep"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#sampleCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>sampleCount</rdfs:label>
    <rdfs:comment>Rows used after duplicate removal.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Dataset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#seedValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>seedValue</rdfs:label>
    <rdfs:comment>The value.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Seed"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#testCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>testCount</rdfs:label>
    <rdfs:comment>Number of test functions in the package.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Package"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#unitsPerHiddenLayer">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>unitsPerHiddenLayer</rdfs:label>
    <rdfs:comment>Units in each hidden layer.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </owl:DatatypeProperty>
  <owl:DatatypeProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#version">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>version</rdfs:label>
    <rdfs:comment>The pinned version in pyproject.toml.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Library"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>
  <owl:NamedIndividual rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#A1">
    <rdf:type rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
    <rdfs:label>A1</rdfs:label>
    <rdfs:comment>A1: 1 hidden layer of 32 sigmoid units.</rdfs:comment>
    <nnfs:definedIn rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#ClassificationConfig"/>
    <nnfs:definedIn rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#RegressionConfig"/>
    <nnfs:hiddenLayerCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</nnfs:hiddenLayerCount>
    <nnfs:unitsPerHiddenLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32</nnfs:unitsPerHiddenLayer>
    <nnfs:usesHiddenActivation rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Sigmoid"/>
    <nnfs:usesTechnique rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#NormalInitialization"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#A1_dropout">
    <rdf:type rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
    <rdfs:label>A1-dropout</rdfs:label>
    <rdfs:comment>A1-dropout: 1 hidden layer of 32 sigmoid units; dropout 0.2.</rdfs:comment>
    <nnfs:definedIn rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#ClassificationConfig"/>
    <nnfs:definedIn rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#RegressionConfig"/>
    <nnfs:dropoutRate rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.2</nnfs:dropoutRate>
    <nnfs:hiddenLayerCount rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</nnfs:hiddenLayerCount>
    <nnfs:unitsPerHiddenLayer rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32</nnfs:unitsPerHiddenLayer>
    <nnfs:usesHiddenActivation rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Sigmoid"/>
    <nnfs:usesTechnique rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Dropout"/>
    <nnfs:usesTechnique rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#NormalInitialization"/>
    <nnfs:variantOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#A1"/>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#A2">
    <rdf:type rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
    <rdfs:label>A2</rdfs:label>
    <rdfs:comment>A2: 3 hidden layers of 32 relu units.</rdfs:comment>
