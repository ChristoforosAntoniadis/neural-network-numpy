<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
  xmlns:nnfs="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#"
>
  <owl:Ontology rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology">
    <rdfs:label>neural-network-numpy knowledge base</rdfs:label>
    <rdfs:comment>The repository as nodes and edges: modules, packages, artifacts and make targets, what they read, write, import and belong to, and the concepts the code implements (tasks, architectures, techniques, optimizers, libraries). Generated by tools/build_knowledge_base.py; do not edit by hand, add to knowledge/extensions.owl instead. Start a reasoner (HermiT) to infer the pipeline order (upstreamOf), stage membership and the defined classes.</rdfs:comment>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </owl:Ontology>
  <owl:AnnotationProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#canvasNodeId">
    <rdfs:label>canvasNodeId</rdfs:label>
    <rdfs:comment>Id of the node that represents the individual in knowledge/nn-architecture.canvas.</rdfs:comment>
  </owl:AnnotationProperty>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Activation">
    <rdfs:label>Activation</rdfs:label>
    <rdfs:comment>An activation function.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#AnalysisStageComponent">
    <rdfs:label>AnalysisStageComponent</rdfs:label>
    <rdfs:comment>A node of the AnalysisStage. Inferred through belongsToStage, including the partOf chain.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
          <owl:Restriction>
            <owl:hasValue rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#AnalysisStage"/>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#belongsToStage"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture">
    <rdfs:label>Architecture</rdfs:label>
    <rdfs:comment>A network architecture from the experiment configs.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Artifact">
    <rdfs:label>Artifact</rdfs:label>
    <rdfs:comment>A file that is read or written: configs, data, results, figures, reports, documents.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#BatchSize">
    <rdfs:label>BatchSize</rdfs:label>
    <rdfs:comment>A mini-batch size of the sweep.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#BenchmarkStageComponent">
    <rdfs:label>BenchmarkStageComponent</rdfs:label>
    <rdfs:comment>A node of the BenchmarkStage. Inferred through belongsToStage, including the partOf chain.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
          <owl:Restriction>
            <owl:hasValue rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#BenchmarkStage"/>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#belongsToStage"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#BiasTerm">
    <rdfs:label>BiasTerm</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Technique"/>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#BiasedArchitecture">
    <rdfs:label>BiasedArchitecture</rdfs:label>
    <rdfs:comment>An architecture that uses a BiasTerm technique. Inferred.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#usesTechnique"/>
            <owl:someValuesFrom rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#BiasTerm"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#ClippedArchitecture">
    <rdfs:label>ClippedArchitecture</rdfs:label>
    <rdfs:comment>An architecture that uses a GradientClipping technique. Inferred.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#usesTechnique"/>
            <owl:someValuesFrom rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#GradientClipping"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component">
    <rdfs:label>Component</rdfs:label>
    <rdfs:comment>A node of the architecture: a module, package, artifact or make target.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#ConfigFile">
    <rdfs:label>ConfigFile</rdfs:label>
    <rdfs:comment>A JSON or TOML configuration file.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Artifact"/>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Consumer">
    <rdfs:label>Consumer</rdfs:label>
    <rdfs:comment>A module that reads an artifact. Inferred.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Module"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Module"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#reads"/>
            <owl:someValuesFrom rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Artifact"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#CoreLibrary">
    <rdfs:label>CoreLibrary</rdfs:label>
    <rdfs:comment>A runtime dependency in pyproject's dependencies.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Library"/>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Dataset">
    <rdfs:label>Dataset</rdfs:label>
    <rdfs:comment>A raw dataset CSV.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Artifact"/>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#DeepArchitecture">
    <rdfs:label>DeepArchitecture</rdfs:label>
    <rdfs:comment>An architecture with at least two hidden layers. Inferred from hiddenLayerCount (needs a reasoner with datatype facets, e.g. HermiT).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#hiddenLayerCount"/>
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</xsd:minInclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
    <owl:disjointWith rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#ShallowArchitecture"/>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#DevelopmentLibrary">
    <rdfs:label>DevelopmentLibrary</rdfs:label>
    <rdfs:comment>A dependency of the dev extra: tests, linting, this builder.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Library"/>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Document">
    <rdfs:label>Document</rdfs:label>
    <rdfs:comment>Documentation, build files and other hand-written files.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Artifact"/>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#EarlyStoppingPolicy">
    <rdfs:label>EarlyStoppingPolicy</rdfs:label>
    <rdfs:comment>The early-stopping settings shared by every run.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#EntryPoint">
    <rdfs:label>EntryPoint</rdfs:label>
    <rdfs:comment>A module a make target runs as a script. Inferred.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Module"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Module"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#runBy"/>
            <owl:someValuesFrom rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#MakeTarget"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Figure">
    <rdfs:label>Figure</rdfs:label>
    <rdfs:comment>A set of PNG figures written by a run.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Artifact"/>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#FrameworkReimplementation">
    <rdfs:label>FrameworkReimplementation</rdfs:label>
    <rdfs:comment>A library model that rebuilds one of the network's own architectures (Keras, PyTorch), as opposed to a different model family (scikit-learn). Inferred.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#LibraryModel"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#LibraryModel"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#mirrorsArchitecture"/>
            <owl:someValuesFrom rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#GradientClipping">
    <rdfs:label>GradientClipping</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Technique"/>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#InfrastructureStageComponent">
    <rdfs:label>InfrastructureStageComponent</rdfs:label>
    <rdfs:comment>A node of the InfrastructureStage. Inferred through belongsToStage, including the partOf chain.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
          <owl:Restriction>
            <owl:hasValue rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#InfrastructureStage"/>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#belongsToStage"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Initialization">
    <rdfs:label>Initialization</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Technique"/>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#InputsStageComponent">
    <rdfs:label>InputsStageComponent</rdfs:label>
    <rdfs:comment>A node of the InputsStage. Inferred through belongsToStage, including the partOf chain.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
          <owl:Restriction>
            <owl:hasValue rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#InputsStage"/>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#belongsToStage"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#LayerType">
    <rdfs:label>LayerType</rdfs:label>
    <rdfs:comment>A kind of layer implemented in nn/layers.py.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#LearningRate">
    <rdfs:label>LearningRate</rdfs:label>
    <rdfs:comment>A learning-rate value of the sweep.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Library">
    <rdfs:label>Library</rdfs:label>
    <rdfs:comment>A third-party Python package the code depends on.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#LibraryModel">
    <rdfs:label>LibraryModel</rdfs:label>
    <rdfs:comment>A model trained by a library in the comparison.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Loss">
    <rdfs:label>Loss</rdfs:label>
    <rdfs:comment>A training loss.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#MakeTarget">
    <rdfs:label>MakeTarget</rdfs:label>
    <rdfs:comment>A command in the Makefile.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Metric">
    <rdfs:label>Metric</rdfs:label>
    <rdfs:comment>An evaluation metric.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Module">
    <rdfs:label>Module</rdfs:label>
    <rdfs:comment>A Python source file.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#NetworkLibraryStageComponent">
    <rdfs:label>NetworkLibraryStageComponent</rdfs:label>
    <rdfs:comment>A node of the NetworkLibraryStage. Inferred through belongsToStage, including the partOf chain.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
          <owl:Restriction>
            <owl:hasValue rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#NetworkLibraryStage"/>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#belongsToStage"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Normalization">
    <rdfs:label>Normalization</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Technique"/>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#NormalizedArchitecture">
    <rdfs:label>NormalizedArchitecture</rdfs:label>
    <rdfs:comment>An architecture that uses a Normalization technique. Inferred.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#usesTechnique"/>
            <owl:someValuesFrom rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Normalization"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Optimizer">
    <rdfs:label>Optimizer</rdfs:label>
    <rdfs:comment>A parameter-update rule.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#OptionalLibrary">
    <rdfs:label>OptionalLibrary</rdfs:label>
    <rdfs:comment>A dependency of the benchmarks extra, needed only for the library comparison.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Library"/>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#OptionalModule">
    <rdfs:label>OptionalModule</rdfs:label>
    <rdfs:comment>A module that needs the benchmarks extra to be installed. Inferred.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Module"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Module"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#requiresLibrary"/>
            <owl:someValuesFrom rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#OptionalLibrary"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Package">
    <rdfs:label>Package</rdfs:label>
    <rdfs:comment>A Python package or a top-level source folder.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#PipelineStep">
    <rdfs:label>PipelineStep</rdfs:label>
    <rdfs:comment>A module that reads artifacts and writes others: a step of the pipeline. Inferred.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Module"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Producer"/>
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Consumer"/>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#PreprocessingStageComponent">
    <rdfs:label>PreprocessingStageComponent</rdfs:label>
    <rdfs:comment>A node of the PreprocessingStage. Inferred through belongsToStage, including the partOf chain.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
          <owl:Restriction>
            <owl:hasValue rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#PreprocessingStage"/>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#belongsToStage"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Producer">
    <rdfs:label>Producer</rdfs:label>
    <rdfs:comment>A module that writes an artifact. Inferred.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Module"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Module"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#writes"/>
            <owl:someValuesFrom rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Artifact"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Regularization">
    <rdfs:label>Regularization</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Technique"/>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#RegularizedArchitecture">
    <rdfs:label>RegularizedArchitecture</rdfs:label>
    <rdfs:comment>An architecture that uses a Regularization technique. Inferred.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#usesTechnique"/>
            <owl:someValuesFrom rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Regularization"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Report">
    <rdfs:label>Report</rdfs:label>
    <rdfs:comment>A text report written by a run.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Artifact"/>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#ResultsFile">
    <rdfs:label>ResultsFile</rdfs:label>
    <rdfs:comment>A machine-readable results file written by a run.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Artifact"/>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#ResultsStageComponent">
    <rdfs:label>ResultsStageComponent</rdfs:label>
    <rdfs:comment>A node of the ResultsStage. Inferred through belongsToStage, including the partOf chain.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
          <owl:Restriction>
            <owl:hasValue rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#ResultsStage"/>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#belongsToStage"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Seed">
    <rdfs:label>Seed</rdfs:label>
    <rdfs:comment>A random seed of the sweep: it sets the split, the initial weights, the dropout masks and the shuffling.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#ShallowArchitecture">
    <rdfs:label>ShallowArchitecture</rdfs:label>
    <rdfs:comment>An architecture with at most one hidden layer. Inferred from hiddenLayerCount (needs a reasoner with datatype facets, e.g. HermiT).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#hiddenLayerCount"/>
            <owl:someValuesFrom>
              <rdfs:Datatype>
                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
                <owl:withRestrictions rdf:parseType="Collection">
                  <rdf:Description>
                    <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:maxInclusive>
                  </rdf:Description>
                </owl:withRestrictions>
              </rdfs:Datatype>
            </owl:someValuesFrom>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Stage">
    <rdfs:label>Stage</rdfs:label>
    <rdfs:comment>One of the coloured groups of the architecture canvas.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#StampedArtifact">
    <rdfs:label>StampedArtifact</rdfs:label>
    <rdfs:comment>An output written with a run stamp in its name. Inferred.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Artifact"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Artifact"/>
          <owl:Restriction>
            <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#isStamped"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Sweep">
    <rdfs:label>Sweep</rdfs:label>
    <rdfs:comment>The full experiment grid.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Task">
    <rdfs:label>Task</rdfs:label>
    <rdfs:comment>A learning task: a dataset, a loss and the metrics it is evaluated with.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Technique">
    <rdfs:label>Technique</rdfs:label>
    <rdfs:comment>A modelling or training technique an architecture can use.</rdfs:comment>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#TestModule">
    <rdfs:label>TestModule</rdfs:label>
    <rdfs:comment>A pytest module in tests/.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Module"/>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#TestedModule">
    <rdfs:label>TestedModule</rdfs:label>
    <rdfs:comment>A module that at least one test module imports. Inferred.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Module"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Module"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#testedBy"/>
            <owl:someValuesFrom rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#TestModule"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#ToolScript">
    <rdfs:label>ToolScript</rdfs:label>
    <rdfs:comment>A helper script in tools/.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Module"/>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#TrainingStageComponent">
    <rdfs:label>TrainingStageComponent</rdfs:label>
    <rdfs:comment>A node of the TrainingStage. Inferred through belongsToStage, including the partOf chain.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
          <owl:Restriction>
            <owl:hasValue rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#TrainingStage"/>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#belongsToStage"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:Class rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Variant">
    <rdfs:label>Variant</rdfs:label>
    <rdfs:comment>An architecture derived from another by one change. Inferred.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
    <owl:equivalentClass>
      <owl:Class>
        <owl:intersectionOf rdf:parseType="Collection">
          <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
          <owl:Restriction>
            <owl:onProperty rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#variantOf"/>
            <owl:someValuesFrom rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
          </owl:Restriction>
        </owl:intersectionOf>
      </owl:Class>
    </owl:equivalentClass>
  </owl:Class>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#architectureOfSweep">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>architectureOfSweep</rdfs:label>
    <rdfs:comment>Inverse of hasArchitecture.</rdfs:comment>
    <owl:inverseOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#hasArchitecture"/>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Architecture"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Sweep"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#batchSizeOfSweep">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>batchSizeOfSweep</rdfs:label>
    <rdfs:comment>Inverse of hasBatchSize.</rdfs:comment>
    <owl:inverseOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#hasBatchSize"/>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#BatchSize"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Sweep"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#belongsToStage">
    <rdfs:label>belongsToStage</rdfs:label>
    <rdfs:comment>The stage of the architecture the node belongs to. Asserted for root-level modules, artifacts, make targets and sub-packages; inferred for a sub-package's modules through partOf ∘ belongsToStage. Not declared functional: OWL 2 DL forbids that on a property defined by a chain.</rdfs:comment>
    <owl:propertyChainAxiom rdf:parseType="Collection">
      <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#partOf"/>
      <rdf:Description rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#belongsToStage"/>
    </owl:propertyChainAxiom>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Stage"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#contains">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>contains</rdfs:label>
    <rdfs:comment>Inverse of partOf.</rdfs:comment>
    <owl:inverseOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#partOf"/>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Package"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#covers">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>covers</rdfs:label>
    <rdfs:comment>Inverse of testedBy.</rdfs:comment>
    <owl:inverseOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#testedBy"/>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#TestModule"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Module"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#datasetOfTask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
    <rdfs:label>datasetOfTask</rdfs:label>
    <rdfs:comment>Inverse of onDataset.</rdfs:comment>
    <owl:inverseOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#onDataset"/>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Dataset"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Task"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#definedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>definedIn</rdfs:label>
    <rdfs:comment>The architecture, task, sweep or library model is defined in the config file.</rdfs:comment>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#ConfigFile"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#defines">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>defines</rdfs:label>
    <rdfs:comment>Inverse of definedIn.</rdfs:comment>
    <owl:inverseOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#definedIn"/>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#ConfigFile"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#downstreamOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>downstreamOf</rdfs:label>
    <rdfs:comment>Inverse of upstreamOf.</rdfs:comment>
    <owl:inverseOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#upstreamOf"/>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#earlyStoppingOfSweep">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
    <rdfs:label>earlyStoppingOfSweep</rdfs:label>
    <rdfs:comment>Inverse of hasEarlyStopping.</rdfs:comment>
    <owl:inverseOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#hasEarlyStopping"/>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#EarlyStoppingPolicy"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Sweep"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#evaluatedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>evaluatedBy</rdfs:label>
    <rdfs:comment>An evaluation metric of the task.</rdfs:comment>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Task"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Metric"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#evaluates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
    <rdfs:label>evaluates</rdfs:label>
    <rdfs:comment>Inverse of evaluatedBy.</rdfs:comment>
    <owl:inverseOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#evaluatedBy"/>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Metric"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Task"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#fedBy">
    <rdfs:label>fedBy</rdfs:label>
    <rdfs:comment>Inverse of feeds.</rdfs:comment>
    <owl:inverseOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#feeds"/>
    <rdfs:domain rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
    <rdfs:range rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Component"/>
  </owl:ObjectProperty>
  <owl:ObjectProperty rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#feeds">
    <rdfs:label>feeds</rdfs:label>
    <rdfs:comment>Direct data or code flow from one node to another: a module into the artifact it writes, an artifact into the module that reads it, a module into the module that imports it. Also inferred from writes ∘ readBy.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#upstreamOf"/>
    <owl:propertyChainAxiom rdf:parseType="Collection">
