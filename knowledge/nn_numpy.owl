  <owl:NamedIndividual rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#GlobalNormClipping">
    <rdf:type rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#GradientClipping"/>
    <rdfs:label>global-norm gradient clipping</rdfs:label>
    <rdfs:comment>After each backward pass, if the L2 norm of all gradients exceeds the cap, every gradient is scaled by cap / norm before the optimizer step.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#HeInitialization">
    <rdf:type rdf:resource="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#Initialization"/>
    <rdfs:label>He initialization</rdfs:label>
    <rdfs:comment>Weights drawn from N(0, 2 / fan_in), designed for ReLU.</rdfs:comment>
  </owl:NamedIndividual>
  <owl:NamedIndividual rdf:about="https://github.com/ChristoforosAntoniadis/neural-network-numpy/ontology#InfrastructureStage">
